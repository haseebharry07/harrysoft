PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/accounting-app
# Use a long, random value in every deployed environment.
JWT_SECRET=replace-with-a-long-random-secret
# Optional: restrict CORS in production.
CLIENT_URL=http://localhost:5173

# Initial accounts for `npm run seed:users`. Use strong, distinct passwords.
ADMIN_EMAIL=admin@accounting.com
ADMIN_PASSWORD=admin123
USER_EMAIL=user@accounting.com
USER_PASSWORD=user123
